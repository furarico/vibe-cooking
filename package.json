{
  "name": "vibe-cooking-api",
  "version": "1.0.0",
  "packageManager": "pnpm@10.24.0",
  "scripts": {
    "build": "pnpm compile && pnpm docs:build",
    "compile": "tsp compile .",
    "watch": "tsp compile . --watch",
    "docs:build": "redocly build-docs app-bff-api -o ./dist/app-bff-api.html && redocly build-docs vibe-cooking-api -o ./dist/vibe-cooking-api.html",
    "docs:preview": "redocly preview --project-dir=./tsp-output/schema/"
  },
  "dependencies": {
    "@typespec/http": "latest",
    "@typespec/openapi": "latest",
    "@typespec/openapi3": "latest",
    "@typespec/rest": "latest"
  },
  "devDependencies": {
    "@redocly/cli": "latest",
    "@typespec/compiler": "latest"
  }
}
