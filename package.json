{
  "name": "vibe-cooking-api",
  "version": "1.0.0",
  "scripts": {
    "build": "pnpm compile && pnpm docs:build",
    "compile": "tsp compile .",
    "watch": "tsp compile . --watch",
    "docs:build": "redocly build-docs ./tsp-output/schema/VibeCookingService/openapi.yaml -o ./dist/index.html",
    "docs:preview": "redocly preview-docs ./tsp-output/schema/"
  },
  "dependencies": {
    "@typespec/http": "latest",
    "@typespec/openapi": "latest",
    "@typespec/openapi3": "latest",
    "@typespec/rest": "latest"
  },
  "devDependencies": {
    "@redocly/cli": "latest",
    "@typespec/compiler": "latest"
  }
}
